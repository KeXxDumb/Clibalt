<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
        Un solo tema de arranque, oscuro fijo. Nada de alias dinámicos ni
        cambios de componente en tiempo de ejecución (eso causaba crashes
        en MIUI). Si el usuario cambia cobalt a modo claro, el splash de la
        PRÓXIMA apertura seguirá siendo oscuro por un instante hasta que el
        código real corra y ajuste el color — es una limitación aceptada de
        cómo funciona esta API de Android, a cambio de mucha más estabilidad.
    -->
    <style name="Theme.CobaltWrapper.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/default_dark_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.CobaltWrapper</item>
        <item name="android:statusBarColor">@color/default_dark_bg</item>
        <item name="android:navigationBarColor">@color/default_dark_bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
    </style>

    <style name="Theme.CobaltWrapper" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryDark">@color/brand_primary_dark</item>
        <item name="colorAccent">@color/brand_primary</item>
        <item name="android:windowBackground">@color/default_dark_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
    </style>

    <style name="RoundedThumbnail" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">10dp</item>
    </style>

</resources>
