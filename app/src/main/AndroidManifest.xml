<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.DOWNLOAD_WITHOUT_NOTIFICATION"/>

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.CobaltWrapper.Starting.Dark"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden">

            <!-- Recibir enlaces compartidos desde otras apps -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/plain"/>
            </intent-filter>

        </activity>

        <!--
            El ícono de lanzador real vive en estos dos alias, no en
            MainActivity directamente. Solo uno está "enabled" a la vez;
            la propia app activa el que corresponde apenas detecta el tema
            real de cobalt, así el splash de la PRÓXIMA apertura ya nace
            con el color correcto, sin tener que adivinar.
        -->
        <activity-alias
            android:name=".LauncherDark"
            android:targetActivity=".MainActivity"
            android:theme="@style/Theme.CobaltWrapper.Starting.Dark"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherLight"
            android:targetActivity=".MainActivity"
            android:theme="@style/Theme.CobaltWrapper.Starting.Light"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>

    </application>
</manifest>
